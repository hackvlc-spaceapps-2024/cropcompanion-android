<?xml version="1.0" encoding="utf-8"?>
<com.hackvlc.cropcompanion.ui.AlarmFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarm_frame_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:orientation="vertical">

    <Switch
        android:id="@+id/water_command_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Water" />

    <Switch
        android:id="@+id/light_command_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="Light" />

    <com.hackvlc.cropcompanion.ui.SeekProgressView
        android:id="@+id/window_command_button"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_marginTop="25dp" />


</com.hackvlc.cropcompanion.ui.AlarmFrameLayout>